# Copia este archivo como .env y completa los valores reales.
# El archivo .env NUNCA debe subirse al repositorio.

# ------------------------------------------------------------
# OBLIGATORIO
# ------------------------------------------------------------

# Clave secreta de Django. Genera una con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=ojala-que-las-hojas-no-te-toquen-el-cuerpo-cuando-caigan

# Dominios permitidos, separados por coma (sin espacios).
ALLOWED_HOSTS=limpiezapozossepticos.com,www.limpiezapozossepticos.com,localhost,127.0.0.1

# ------------------------------------------------------------
# OPCIONAL
# ------------------------------------------------------------

# URL base del panel de Wagtail (usada en notificaciones por email).
# Por defecto: http://localhost:8000
WAGTAILADMIN_BASE_URL=https://limpiezapozossepticos.com
